# ---- App ----
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Database ----
# 本地开发默认 SQLite；生产/docker-compose 使用 PostgreSQL
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=mira
DB_PASSWORD=mira_secret_change_me
DB_NAME=mira-dev
# 仅本地开发使用 true；生产必须 false 并使用 migration
DB_SYNC=true

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI ----
AI_PROVIDER=mock            # mock | nvidia
AI_MOCK_FAIL_RATE=0         # 0~1 随机失败演示概率（仅 mock 生效）

# ---- NVIDIA Build（AI_PROVIDER=nvidia 时生效）----
# Key 在 https://build.nvidia.com 登录后生成（nvapi- 开头）
NVIDIA_API_KEY=
# FLUX 系列文生图模型，以 build.nvidia.com 实际可用模型列表为准（如 black-forest-labs/flux.1-schnell / flux.1-dev）
AI_NVIDIA_MODEL=black-forest-labs/flux.1-dev
# OpenAI 兼容端点 base URL
AI_NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai
# 文本模型前置优化（中文 prompt → 英文图像描述 → FLUX 生图；任何失败自动降级为原 prompt）
# OpenAI 兼容 chat/completions 端点，鉴权复用同一 NVIDIA_API_KEY
AI_NVIDIA_LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
AI_NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# true 启用 prompt 优化 / false 跳过直接用原 prompt
AI_NVIDIA_PROMPT_ENHANCE=true

# ---- Uploads（Q7：开发期本地卷，线上建议对象存储）----
UPLOAD_DIR=./uploads

# ---- Payments（Q8 支付系统框架）----
# 支付渠道：mock（模拟，无真实商户资质时默认）| wechat | alipay
PAYMENT_PROVIDER=mock
# 订单过期时间（分钟，默认 15）
PAYMENT_ORDER_EXPIRE_MINUTES=15
# 模拟网关固定签名 token（mock 回调校验用，可随意改）
PAYMENT_MOCK_TOKEN=mira-mock-pay-token
# 站内模拟支付页地址（mock payUrl 指向此路径）
PAYMENT_MOCK_PAY_URL_BASE=/payments/mock-pay

# ---- 微信支付（PAYMENT_PROVIDER=wechat 时必填）----
# 商户号 / AppID / APIv3 密钥（https://pay.weixin.qq.com 商户平台获取）
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_API_V3_KEY=
# 支付结果回调地址（需公网可达，部署时改为 https://你的域名/api/v1/payments/callback/wechat）
WECHAT_NOTIFY_URL=

# ---- 支付宝（PAYMENT_PROVIDER=alipay 时必填）----
# 应用 AppID / 应用私钥 / 支付宝公钥（https://open.alipay.com 开放平台获取）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 支付结果回调地址（需公网可达，部署时改为 https://你的域名/api/v1/payments/callback/alipay）
ALIPAY_NOTIFY_URL=

# ---- Frontend（apps/web/.env）----
VITE_API_BASE_URL=/api/v1   # 开发走 Vite proxy；生产由 nginx 反代
