# Production template for docker compose. Copy to .env.production and replace
# every CHANGE_ME value before startup. deploy.sh can generate these secrets.

NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false
CORS_ORIGINS=http://localhost:8080

STACK_NAME=mira-starter
WEB_PORT=8080

DB_USER=mira
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=mira
DB_SYNC=false

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_PROVIDER=mock
AI_MOCK_FAIL_RATE=0
NVIDIA_API_KEY=
AI_NVIDIA_MODEL=black-forest-labs/flux.1-dev
AI_NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai
AI_NVIDIA_LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
AI_NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_PROMPT_ENHANCE=true

PAYMENT_PROVIDER=mock
PAYMENT_ORDER_EXPIRE_MINUTES=15
PAYMENT_MOCK_TOKEN=CHANGE_ME_MOCK_TOKEN
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
