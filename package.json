{
  "name": "mira",
  "version": "1.0.0",
  "private": true,
  "description": "MIRA·弥画 — AI 视觉设计工具（npm workspaces monorepo）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:contracts": "npm run build -w @mira/contracts",
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm run dev -w @mira/web",
    "dev:api": "npm run dev -w @mira/api",
    "build": "npm run build:contracts && npm run build -w @mira/web && npm run build -w @mira/api",
    "start": "npm run start:prod -w @mira/api",
    "start:web": "npm run preview -w @mira/web",
    "migration:run": "npm run migration:run -w @mira/api",
    "migration:generate": "npm run migration:generate -w @mira/api",
    "typecheck": "npm run build:contracts && npm run typecheck -w @mira/web && npm run typecheck -w @mira/api",
    "smoke": "node scripts/smoke.mjs",
    "smoke-p1": "node scripts/smoke-p1.mjs",
    "qa:cases": "node scripts/qa-cases.mjs",
    "qa:contrast": "node scripts/qa-contrast-check.mjs",
    "qa:contrast:theme": "node scripts/qa-contrast-check.mjs --theme",
    "qa:security": "node scripts/qa-production-security.mjs",
    "gen:theme-css": "node scripts/gen-theme-css.mjs",
    "e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm run build && npm run qa:cases && npm run qa:contrast && npm run qa:contrast:theme && npm run qa:security"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "MIT"
}
